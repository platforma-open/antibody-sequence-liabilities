{
  "name": "@platforma-open/milaboratories.antibody-sequence-liabilities",
  "version": "5.2.0",
  "files": [
    "dist",
    "block-pack"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "sources": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "ts-builder build --target block-facade && block-tools pack",
    "do-pack": "shx rm -f package.tgz && pnpm pack && shx mv *.tgz package.tgz",
    "mark-stable": "block-tools mark-stable -r 's3://milab-euce1-prod-pkgs-s3-block-registry/pub/releases/?region=eu-central-1'",
    "prepublishOnly": "block-tools publish -r s3://milab-euce1-prod-pkgs-s3-block-registry/pub/releases/?region=eu-central-1 --registry-serve-url https://blocks.pl-open.science",
    "check": "ts-builder type-check --target block-facade"
  },
  "dependencies": {},
  "devDependencies": {
    "@milaboratories/ts-builder": "catalog:",
    "@milaboratories/ts-configs": "catalog:",
    "@platforma-open/milaboratories.antibody-sequence-liabilities.kind": "workspace:*",
    "@platforma-open/milaboratories.antibody-sequence-liabilities.model": "workspace:*",
    "@platforma-open/milaboratories.antibody-sequence-liabilities.ui": "workspace:*",
    "@platforma-open/milaboratories.antibody-sequence-liabilities.workflow": "workspace:*",
    "@platforma-sdk/block-tools": "catalog:",
    "@platforma-sdk/model": "catalog:",
    "shx": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.12.0",
  "block": {
    "components": {
      "workflow": "@platforma-open/milaboratories.antibody-sequence-liabilities.workflow/dist/tengo/tpl/main.plj.gz",
      "model": "@platforma-open/milaboratories.antibody-sequence-liabilities.model/dist/model.json",
      "ui": "@platforma-open/milaboratories.antibody-sequence-liabilities.ui/dist"
    },
    "meta": {
      "title": "Sequence Liabilities",
      "logo": "file:../logos/block-logo.png",
      "url": "https://github.com/platforma-open/antibody-sequence-liabilities",
      "docs": "https://docs.platforma.bio/guides/antibody-discovery/sequence-liabilities/",
      "support": "mailto:support@milaboratories.com",
      "description": "Identifies sequence liabilities that may impact manufacturability, stability, or safety in antibody/TCR or peptide sequences.",
      "longDescription": "file:../docs/description.md",
      "changelog": "file:../CHANGELOG.md",
      "tags": [
        "airr",
        "antibody",
        "peptide",
        "downstream"
      ],
      "organization": {
        "name": "MiLaboratories Inc",
        "url": "https://milaboratories.com/",
        "logo": "file:../logos/organization-logo.png"
      },
      "marketplaceRanking": 15000
    }
  }
}
