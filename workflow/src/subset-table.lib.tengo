// Tables restricted to an optional subset column (a `pl7.app/isSubset` column on the entity
// axis, picked in PlDatasetSelector).
pframes := import("@platforma-sdk/workflow-tengo:pframes")
ll := import("@platforma-sdk/workflow-tengo:ll")

// A TSV builder that keeps only the entities in an optional subset column. Without a subset it
// is the plain xsv builder.
//
// add: a column keyed on the entity. It is filtered to the subset, and the table's rows are
// all entities found in any added column (an entity may lack a chain or a feature).
//
// addLookup: a column not keyed on the entity (e.g. keyed on the repertoire parentId), so the
// filter can't apply to it. It adds no rows: it only fills its values into the rows from add,
// matched through a shared axis (setColumnJoin("left")).
newTableBuilder := func(filterColumn) {
	if is_undefined(filterColumn) {
		b := pframes.tsvFileBuilder()
		return {
			add: b.add,
			addLookup: b.add,
			setAxisHeader: b.setAxisHeader,
			mem: b.mem,
			cpu: b.cpu,
			build: b.build
		}
	}
	tb := pframes.tableBuilder("tsv").setJoinMode("full").setColumnJoin("left")
	nColumns := 0
	return {
		add: func(column, opts) {
			tb.addPrimary("col" + string(nColumns), {
				__isPrimaryRef: "v1",
				column: column,
				filter: filterColumn
			}, opts)
			nColumns += 1
		},
		addLookup: func(column, opts) { tb.addColumn(column, opts) },
		setAxisHeader: func(matcher, header) { tb.setAxisHeader(matcher, header) },
		mem: func(amount) { tb.mem(amount) },
		cpu: func(amount) { tb.cpu(amount) },
		build: func() { return tb.build() }
	}
}

export ll.toStrict({
	newTableBuilder: newTableBuilder
})
